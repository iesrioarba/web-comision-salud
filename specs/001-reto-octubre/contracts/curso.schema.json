{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:web-comision-salud:schema:curso",
  "title": "Curso y calendario",
  "description": "Contrato de content/curso.yml. Ver data-model.md. El orden de los meses, el segundo año del curso y que en_curso apunte a un reto publicado del mismo curso los comprueba scripts/validate-content.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["curso", "meses"],
  "properties": {
    "curso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
    "meses": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mes"],
        "properties": {
          "mes": { "$ref": "#/$defs/mes" },
          "tema": { "anyOf": [{ "$ref": "#/$defs/vacio" }, { "type": "string", "maxLength": 80 }] }
        }
      }
    },
    "en_curso": {
      "anyOf": [
        { "$ref": "#/$defs/vacio" },
        { "type": "string", "pattern": "^content/retos/[0-9]{4}-[0-9]{4}-[a-z]+\\.yml$" }
      ]
    },
    "proximo_mes": { "anyOf": [{ "$ref": "#/$defs/vacio" }, { "$ref": "#/$defs/mes" }] }
  },
  "$defs": {
    "vacio": { "enum": ["", null] },
    "mes": { "enum": ["octubre", "noviembre", "diciembre", "enero", "febrero", "marzo", "abril", "mayo", "junio"] }
  }
}
