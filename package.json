{
  "name": "web-comision-salud",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "test": "node --test tests/unit/",
    "build": "node scripts/clean-output.js && npm run comprobar:contenido && eleventy",
    "build:fixtures": "node scripts/build-fixtures.js",
    "validar": "html-validate \"_site/**/*.html\" \"_site-fixtures/**/*.html\"",
    "comprobar:caracteres": "node scripts/check-invisible-chars.js",
    "comprobar:esquemas": "node scripts/check-schemas-sync.js",
    "comprobar:contenido": "node scripts/validate-content.js",
    "comprobar:enlaces": "node scripts/check-links.js",
    "comprobar:web": "playwright test",
    "comprobar:rendimiento": "lhci collect && lhci assert",
    "comprobar": "npm run comprobar:caracteres && npm run comprobar:esquemas && npm run comprobar:contenido && npm test && npm run build && npm run build:fixtures && npm run validar && npm run comprobar:enlaces && npm run comprobar:web && npm run comprobar:rendimiento"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "html-validate": "11.21.1",
    "linkinator": "8.1.0"
  }
}
